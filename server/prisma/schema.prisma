generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameMode {
  GTN
  BC
}

enum Difficulty {
  easy
  medium
  hard
  adaptive
}

enum GameStatus {
  in_progress
  won
  lost
  abandoned
}

model User {
  id           String   @id @default(uuid())
  guestId      String?  @unique
  username     String?  @unique
  email        String?  @unique
  passwordHash String?
  role         String   @default("user")
  totalGames   Int      @default(0)
  gtnWins      Int      @default(0)
  bcWins       Int      @default(0)
  xoxWins      Int      @default(0)
  mathWins     Int      @default(0)
  sudokuWins   Int      @default(0)
  rummyWins    Int      @default(0)
  queensWins   Int      @default(0)
  tangoWins    Int      @default(0)
  xp           Int      @default(0)
  coins        Int      @default(0)
  equippedFrame String?
  equippedTitle String?
  failedLogins Int      @default(0)
  banned       Boolean  @default(false)
  bannedAt     DateTime?
  deleted      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  games          Game[]
  featureUnlocks FeatureUnlock[]
  badges         UserBadge[]

  @@map("users")
}

model Game {
  id         String     @id @default(uuid())
  userId     String
  mode       GameMode
  difficulty Difficulty
  rangeMax   Int
  status     GameStatus @default(in_progress)
  score      Int        @default(0)
  optimalMoves Int?
  actualMoves  Int      @default(0)
  startedAt  DateTime   @default(now())
  endedAt    DateTime?

  user   User    @relation(fields: [userId], references: [id])
  rounds Round[]

  @@map("games")
}

model Round {
  id         String   @id @default(uuid())
  gameId     String
  roundNumber Int
  secret     String
  guessCount Int      @default(0)
  won        Boolean  @default(false)
  startedAt  DateTime @default(now())
  endedAt    DateTime?

  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  guesses Guess[]

  @@map("rounds")
}

model Guess {
  id          String   @id @default(uuid())
  roundId     String
  value       String
  result      Json
  responseMs  Int?
  createdAt   DateTime @default(now())

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("guesses")
}

model FeatureUnlock {
  id        String   @id @default(uuid())
  userId    String
  feature   String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, feature])
  @@map("feature_unlocks")
}

model Badge {
  id          String @id @default(uuid())
  slug        String @unique
  name        String
  description String
  icon        String
  condition   Json

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@id([userId, badgeId])
  @@map("user_badges")
}

// ── Social graph (durable; survives restarts/deploys) ───────────────────────
// Stored as plain id columns (no FK relations) to keep the User model untouched.
// A friendship is one row with the pair stored in sorted order (userAId < userBId)
// so the unique constraint dedupes A↔B regardless of who added whom.
model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("friendships")
}

// A pending request is directional (fromId → toId); cleared on accept/decline.
model FriendRequest {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@index([toId])
  @@map("friend_requests")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("user_blocks")
}
